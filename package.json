{
  "name": "member-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A full stack TypeScript demo of a paid membership program: signup flows, a home-grown experimentation layer, idempotent APIs, tests and monitoring.",
  "license": "MIT",
  "author": "Chris Sanborn",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/main.ts",
    "simulate": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/simulate.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:e2e": "playwright test",
    "screenshot": "playwright test -c playwright.screenshot.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
